<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Recurso nativo: notificaciones locales.
         Desde Android 13 (API 33) el permiso se pide en ejecución. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Recurso nativo: biometría. Permiso normal, se concede al instalar. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- El selector de documentos y los intents de contacto no piden permisos:
         la app solo recibe el archivo que la usuaria elige. -->

    <application
        android:name=".AplicacionWim"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wim100"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Comparte los CV de prueba de forma segura, sin exponer rutas del disco. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>
    </application>
</manifest>
